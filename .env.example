# Скопируйте этот файл в .env.local и заполните значения.
# Сайт работает и без них: пустые ключи просто отключают свою функцию.

# ── Заявки ────────────────────────────────────────────────
# Нужен хотя бы один из двух каналов, иначе форма ответит «заявки временно не принимаются».

# Telegram: токен бота из @BotFather и id чата, куда приходят заявки
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase: Project Settings → API
SUPABASE_URL=
# Секретный ключ (service_role или sb_secret_…). Только для сервера, никогда не публикуйте его.
SUPABASE_SERVICE_ROLE_KEY=

# ── Свежие посты в блоке @arshparty ───────────────────────
# Без ключа вместо постов показывается карточка профиля.

# ВКонтакте: сервисный ключ доступа приложения VK (vk.com/apps?act=manage → приложение → Ключи доступа)
VK_SERVICE_TOKEN=

# Instagram: долгоживущий токен Instagram API (действует 60 дней, продлевайте, см. README)
INSTAGRAM_ACCESS_TOKEN=

# ── Админка (/admin) ──────────────────────────────────────
# Пароль владельца. Придумайте длинный: от 12 символов, буквы, цифры, знаки.
ADMIN_PASSWORD=
# Необязательно: отдельный секрет для подписи входа (любая длинная случайная строка).
# Если не задан, используется пароль. Смена любого из двух выкидывает всех из админки.
ADMIN_SESSION_SECRET=

# ── Кухня (/kitchen) ──────────────────────────────────────
# Отдельный пароль для повара: только отметки «есть сегодня / нет» и блюдо дня, без остальной админки.
KITCHEN_PASSWORD=

# ── Свой сервер в России (заполняется на сервере автоматически, на компьютере не нужно) ──
# Если задан POSTGREST_URL, сайт ходит в свой PostgREST вместо Supabase.
# Если задан STORAGE_DIR, фото и видео хранятся на диске сервера вместо Supabase Storage.
# POSTGREST_URL=http://127.0.0.1:3001
# STORAGE_DIR=/srv/arshparty/storage
# FILES_SECRET=длинная-случайная-строка

# ── Уведомления в VK (дубль Telegram: из России Telegram бывает недоступен) ──
# Ключ сообщества: «Управление» → «Работа с API» → «Создать ключ», доступ к сообщениям сообщества.
VK_GROUP_TOKEN=
# Кому писать (id страниц через запятую). Заполняет: node scripts/vk-setup.mjs
VK_NOTIFY_USER_IDS=
